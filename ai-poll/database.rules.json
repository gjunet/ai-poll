{
  "rules": {
    "polls": {
      "$poll": {
        ".read": "$poll.matches(/^[a-z0-9-]{1,40}$/)",
        "votes": {
          "$vote": {
            ".write": "!data.exists() && newData.exists()",
            ".validate": "newData.hasChildren(['choice', 't'])",
            "choice": {
              ".validate": "newData.isString() && newData.val().matches(/^(none|chat|coding|agents)$/)"
            },
            "t": {
              ".validate": "newData.val() === now"
            },
            "$other": {
              ".validate": false
            }
          }
        }
      }
    }
  }
}
